    <worksheet name='Delivery Delay analysis'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Top 10 States with the Most Late Orders</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='olist_delivery_dashboard.csv' name='federated.0dl4jyz0ib6tiu1cld1i01gx2fpy' />
          </datasources>
          <datasource-dependencies datasource='federated.0dl4jyz0ib6tiu1cld1i01gx2fpy'>
            <column caption='Late Order Performance' datatype='string' name='[Calculation_0451545771585543]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF COUNTD(&#10;    IF [delivery_status] = &quot;Late&quot;&#10;    THEN [order_id]&#10;    END&#10;) &gt;= 1000 THEN &quot;High Late Orders&quot;&#10;&#10;ELSEIF COUNTD(&#10;    IF [delivery_status] = &quot;Late&quot;&#10;    THEN [order_id]&#10;    END&#10;) &gt;= 300 THEN &quot;Moderate Late Orders&quot;&#10;&#10;ELSE &quot;Lower Late Orders&quot;&#10;END' />
            </column>
            <column caption='Late Orders Count ' datatype='integer' name='[Calculation_0451545773981704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [delivery_status] = &quot;Late&quot;&#10;    THEN [order_id]&#10;    END&#10;)' />
            </column>
            <column caption='Customer State' datatype='string' name='[customer_state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption='Delivery Status' datatype='string' name='[delivery_status]' role='dimension' type='nominal' />
            <column-instance column='[customer_state]' derivation='None' name='[none:customer_state:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_status]' derivation='None' name='[none:delivery_status:nk]' pivot='key' type='nominal' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0451545771585543]' derivation='User' name='[usr:Calculation_0451545771585543:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0451545773981704]' derivation='User' name='[usr:Calculation_0451545773981704:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0dl4jyz0ib6tiu1cld1i01gx2fpy].[none:customer_state:nk]'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='COUNTD([order_id])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:customer_state:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <computed-sort column='[federated.0dl4jyz0ib6tiu1cld1i01gx2fpy].[none:customer_state:nk]' direction='DESC' using='[federated.0dl4jyz0ib6tiu1cld1i01gx2fpy].[usr:Calculation_0451545773981704:qk]' />
          <filter class='categorical' column='[federated.0dl4jyz0ib6tiu1cld1i01gx2fpy].[none:delivery_status:nk]'>
            <groupfilter function='level-members' level='[none:delivery_status:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.0dl4jyz0ib6tiu1cld1i01gx2fpy].[none:customer_state:nk]</column>
            <column>[federated.0dl4jyz0ib6tiu1cld1i01gx2fpy].[none:delivery_status:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane id='2' selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[federated.0dl4jyz0ib6tiu1cld1i01gx2fpy].[usr:Calculation_0451545771585543:nk]' />
            </encodings>
