  <worksheets>
    <worksheet name='Average Delivery Days '>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='16'>Average Delivery Days</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='olist_delivery_dashboard.csv' name='federated.0dl4jyz0ib6tiu1cld1i01gx2fpy' />
          </datasources>
          <datasource-dependencies datasource='federated.0dl4jyz0ib6tiu1cld1i01gx2fpy'>
            <column caption='Average Delivery Days ' datatype='real' name='[Calculation_0451544405667844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([delivery_duration_days])' />
            </column>
            <column caption='Delivery Duration Days' datatype='real' name='[delivery_duration_days]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0451544405667844]' derivation='User' name='[usr:Calculation_0451544405667844:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='height' value='19' />
            <format attr='width' value='99' />
          </style-rule>
        </style>
        <panes>
