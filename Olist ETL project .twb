      <aliases enabled='yes' />
      <column caption='On_Time Delivery Rate ' datatype='real' name='[Calculation_0451544366632960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [delivery_delay_days] &lt;= 0&#10;    THEN [order_id]&#10;    END&#10;)&#10;/&#10;COUNTD(&#10;    IF NOT ISNULL([delivery_delay_days])&#10;    THEN [order_id]&#10;    END&#10;)' />
      </column>
      <column caption='Average  Delivery Days' datatype='real' name='[Calculation_0451544401334274]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([delivery_duration_days])' />
      </column>
      <column caption='On Time Delivery Rate ' datatype='real' name='[Calculation_0451544403476483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [delivery_delay_days] &lt;= 0&#10;    THEN [order_id]&#10;    END&#10;)&#10;/&#10;COUNTD(&#10;    IF NOT ISNULL([delivery_delay_days])&#10;    THEN [order_id]&#10;    END&#10;)' />
      </column>
      <column caption='Average Delivery Days ' datatype='real' name='[Calculation_0451544405667844]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([delivery_duration_days])' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_0451545110298629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [delivery_status] = &quot;Late&quot;&#10;    THEN [order_id]&#10;    END&#10;)' />
      </column>
      <column caption='Late Order Flag' datatype='integer' name='[Calculation_0451545431842822]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [delivery_status] = &quot;Late&quot; THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Late Order Performance' datatype='string' name='[Calculation_0451545771585543]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD(&#10;    IF [delivery_status] = &quot;Late&quot;&#10;    THEN [order_id]&#10;    END&#10;) &gt;= 1000 THEN &quot;High Late Orders&quot;&#10;&#10;ELSEIF COUNTD(&#10;    IF [delivery_status] = &quot;Late&quot;&#10;    THEN [order_id]&#10;    END&#10;) &gt;= 300 THEN &quot;Moderate Late Orders&quot;&#10;&#10;ELSE &quot;Lower Late Orders&quot;&#10;END' />
      </column>
      <column caption='Late Orders Count ' datatype='integer' name='[Calculation_0451545773981704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [delivery_status] = &quot;Late&quot;&#10;    THEN [order_id]&#10;    END&#10;)' />
      </column>
